
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BankUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  balance   Int    @default(10000)
  password String 
  createdAt DateTime @default(now())
}
